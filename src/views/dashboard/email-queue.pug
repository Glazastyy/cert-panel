extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h2 Fila de Envio
    .d-flex.gap-2
      a.btn.btn-outline-primary(href='/dashboard/emails/queue')
        i.bi.bi-arrow-clockwise.me-2
        | Atualizar
      a.btn.btn-secondary(href='/dashboard/emails')
        i.bi.bi-arrow-left.me-2
        | Voltar

  .card.mb-4
    .card-header.bg-secondary.text-white
      h5.mb-0 Resumo
    .card-body
      .row.g-3
        .col-md-3
          .border.rounded.p-3.h-100
            .text-muted.small Pendentes
            .fs-4.fw-bold #{queueSummary ? queueSummary.pending : 0}
        .col-md-3
          .border.rounded.p-3.h-100
            .text-muted.small Processando
            .fs-4.fw-bold #{queueSummary ? queueSummary.processing : 0}
        .col-md-3
          .border.rounded.p-3.h-100
            .text-muted.small Enviados
            .fs-4.fw-bold #{queueSummary ? queueSummary.sent : 0}
        .col-md-3
          .border.rounded.p-3.h-100
            .text-muted.small Falhas
            .fs-4.fw-bold #{queueSummary ? queueSummary.failed : 0}

  .card
    .card-header.bg-primary.text-white
      .d-flex.justify-content-between.align-items-center
        h5.mb-0 Detalhes
        .btn-group.btn-group-sm
          a.btn(class=status === 'all' ? 'btn-light' : 'btn-outline-light', href='/dashboard/emails/queue') Todos
          a.btn(class=status === 'pending' ? 'btn-light' : 'btn-outline-light', href='/dashboard/emails/queue?status=pending') Pendentes
          a.btn(class=status === 'processing' ? 'btn-light' : 'btn-outline-light', href='/dashboard/emails/queue?status=processing') Processando
          a.btn(class=status === 'sent' ? 'btn-light' : 'btn-outline-light', href='/dashboard/emails/queue?status=sent') Enviados
          a.btn(class=status === 'failed' ? 'btn-light' : 'btn-outline-light', href='/dashboard/emails/queue?status=failed') Falhas
    .card-body.p-0
      .table-responsive.table-frame
        table.table.table-hover.mb-0.data-table
          thead
            tr
              th ID
              th Destinatário
              th Assunto
              th Formato
              th Status
              th Tentativas
              th Próxima tentativa
              th Criado em
              th Atualizado em
              th Enviado em
          tbody
            if deliveries && deliveries.length
              each delivery in deliveries
                tr
                  td.date-cell ##{delivery.id}
                  td.email-cell #{delivery.toEmail}
                  td.entity-cell #{delivery.subject}
                  td.status-cell
                    span.badge.bg-secondary #{delivery.messageFormat === 'html' ? 'HTML' : 'Texto'}
                  td.status-cell
                    if delivery.status === 'sent'
                      span.badge.bg-success Enviado
                    else if delivery.status === 'failed'
                      span.badge.bg-danger Falha
                    else if delivery.status === 'processing'
                      span.badge.bg-info Processando
                    else
                      span.badge.bg-warning.text-dark Pendente
                    if delivery.lastError
                      div.small.text-muted #{delivery.lastError}
                  td.date-cell #{delivery.attempts}
                  td.date-cell #{delivery.nextAttemptAt ? delivery.nextAttemptAt.toLocaleString('pt-BR') : '-'}
                  td.date-cell #{delivery.createdAt ? delivery.createdAt.toLocaleString('pt-BR') : '-'}
                  td.date-cell #{delivery.updatedAt ? delivery.updatedAt.toLocaleString('pt-BR') : '-'}
                  td.date-cell #{delivery.sentAt ? delivery.sentAt.toLocaleString('pt-BR') : '-'}
            else
              tr
                td.text-center.text-muted(colspan='10') Nenhum envio encontrado.
