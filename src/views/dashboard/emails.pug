extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h2 Enviar E-mail
    a.btn.btn-secondary(href='/dashboard')
      i.bi.bi-arrow-left.me-2
      | Voltar

  .card
    .card-header.bg-primary.text-white
      h5.mb-0 Nova Mensagem
    .card-body
      form(action='/dashboard/emails', method='POST')
        .mb-3
          label.form-label Destinatários
          .form-check
            input#recipientModeAll.form-check-input(type='radio', name='recipientMode', value='all', checked=!formData || formData.recipientMode !== 'selected')
            label.form-check-label(for='recipientModeAll') Todos os usuários ativos
          .form-check
            input#recipientModeSelected.form-check-input(type='radio', name='recipientMode', value='selected', checked=formData && formData.recipientMode === 'selected')
            label.form-check-label(for='recipientModeSelected') Usuários específicos

        .mb-3
          label.form-label(for='userIds') Usuários
          select#userIds.form-select(name='userIds', multiple, size='8')
            each targetUser in users
              option(value=targetUser.id, selected=formData && formData.userIds && [].concat(formData.userIds).map(String).includes(String(targetUser.id))) #{targetUser.fullName} (#{targetUser.email})

        .mb-3
          label.form-label(for='subject') Assunto
          input#subject.form-control(type='text', name='subject', value=formData ? formData.subject : '', maxlength='160', required)

        .mb-3
          label.form-label Formato
          .form-check.form-check-inline
            input#messageFormatText.form-check-input(type='radio', name='messageFormat', value='text', checked=!formData || formData.messageFormat !== 'html')
            label.form-check-label(for='messageFormatText') Texto simples
          .form-check.form-check-inline
            input#messageFormatHtml.form-check-input(type='radio', name='messageFormat', value='html', checked=formData && formData.messageFormat === 'html')
            label.form-check-label(for='messageFormatHtml') HTML

        .mb-3
          label.form-label(for='message') Mensagem
          textarea#message.form-control(name='message', rows='14', maxlength='50000', required)= formData ? formData.message : ''

        .mb-3
          .card.border-secondary
            .card-header
              h6.mb-0 Variáveis disponíveis
            .card-body
              .row.g-2
                .col-md-6
                  code {{user.fullName}}
                  br
                  code {{user.firstName}}
                  br
                  code {{user.username}}
                  br
                  code {{user.email}}
                  br
                  code {{user.id}}
                .col-md-6
                  code {{date.today}}
                  br
                  code {{date.now}}
                  br
                  code {{urls.base}}
                  br
                  code {{urls.login}}
                  br
                  code {{urls.dashboard}}
                  br
                  code {{urls.certificates}}
                  br
                  code {{urls.certificateRequests}}

        .d-flex.justify-content-end
          button.btn.btn-primary(type='submit')
            i.bi.bi-send.me-2
            | Enviar E-mail

  .card.mt-4
    .card-header.bg-secondary.text-white
      h5.mb-0 Fila de Envio
    .card-body
      .row.g-3.mb-4
        .col-md-3
          .border.rounded.p-3.h-100
            .text-muted.small Pendentes
            .fs-4.fw-bold #{queueSummary ? queueSummary.pending : 0}
        .col-md-3
          .border.rounded.p-3.h-100
            .text-muted.small Processando
            .fs-4.fw-bold #{queueSummary ? queueSummary.processing : 0}
        .col-md-3
          .border.rounded.p-3.h-100
            .text-muted.small Enviados
            .fs-4.fw-bold #{queueSummary ? queueSummary.sent : 0}
        .col-md-3
          .border.rounded.p-3.h-100
            .text-muted.small Falhas
            .fs-4.fw-bold #{queueSummary ? queueSummary.failed : 0}

      .table-responsive.table-frame
        table.table.table-hover.mb-0.data-table
          thead
            tr
              th Destinatário
              th Assunto
              th Status
              th Tentativas
              th Criado em
              th Enviado em
          tbody
            if recentDeliveries && recentDeliveries.length
              each delivery in recentDeliveries
                tr
                  td.email-cell #{delivery.toEmail}
                  td.entity-cell #{delivery.subject}
                  td.status-cell
                    if delivery.status === 'sent'
                      span.badge.bg-success Enviado
                    else if delivery.status === 'failed'
                      span.badge.bg-danger Falha
                    else if delivery.status === 'processing'
                      span.badge.bg-info Processando
                    else
                      span.badge.bg-warning.text-dark Pendente
                    if delivery.lastError
                      div.small.text-muted #{delivery.lastError}
                  td.date-cell #{delivery.attempts}
                  td.date-cell #{delivery.createdAt ? delivery.createdAt.toLocaleString('pt-BR') : '-'}
                  td.date-cell #{delivery.sentAt ? delivery.sentAt.toLocaleString('pt-BR') : '-'}
            else
              tr
                td.text-center.text-muted(colspan='6') Nenhum envio na fila.
