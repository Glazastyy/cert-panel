extends ../layout

block content
  .d-flex.justify-content-between.align-items-center.mb-4
    h2 Gerenciar Certificados
    .btn-group
      a.btn.btn-primary(href='/certificates/issue/ecpf')
        i.bi.bi-person-badge.me-2
        | Emitir e-CPF
      a.btn.btn-primary(href='/certificates/issue/ecnpj')
        i.bi.bi-building.me-2
        | Emitir e-CNPJ
      a.btn.btn-outline-primary(href='/dashboard/certificate-requests')
        i.bi.bi-inbox.me-2
        | Solicitações
  
  .mb-3
    .btn-group
      a.btn(class=!status ? 'btn-primary' : 'btn-outline-primary', href='/dashboard/certificates') Todos
      a.btn(class=status === 'active' ? 'btn-primary' : 'btn-outline-primary', href='/dashboard/certificates?status=active') Ativos
      a.btn(class=status === 'revoked' ? 'btn-primary' : 'btn-outline-primary', href='/dashboard/certificates?status=revoked') Revogados

  .card
    .card-header.bg-primary.text-white
      h5.mb-0 Lista de Certificados
    
    .table-responsive.table-frame
      table.table.table-hover.mb-0.data-table.certificates-table
        thead
          tr
            th Tipo
            th Série
            th Titular
            th Emitido em
            th Validade
            th Status
            th Usuário
            th Ações
        tbody
          if certificates && certificates.length > 0
            each cert in certificates
              tr
                td.type-cell #{cert.type}
                td.serial-cell #{cert.serialNumber.substring(0, 8)}...
                td.entity-cell
                  if cert.type === 'e-CPF'
                    span.entity-name #{cert.subject.name}
                    br
                    small.text-muted CPF: #{cert.subject.cpf}
                  else
                    span.entity-name #{cert.subject.companyName}
                    br
                    small.text-muted CNPJ: #{cert.subject.cnpj}
                td.date-cell #{cert.createdAt.toLocaleDateString('pt-BR')}
                td.date-cell #{cert.validTo.toLocaleDateString('pt-BR')}
                td.status-cell
                  if cert.revoked
                    span.badge.bg-danger Revogado
                  else if new Date() > cert.validTo
                    span.badge.bg-warning.text-dark Expirado
                  else
                    span.badge.bg-success Válido
                td.entity-cell #{cert.User.fullName}
                td.action-cell
                  .table-actions
                    a.btn.btn-sm.btn-primary.action-btn(href=`/certificates/view/${cert.id}`, title='Visualizar')
                      i.bi.bi-eye.me-1
                      | Visualizar
          else
            tr
              td(colspan='8').text-center Nenhum certificado encontrado.

