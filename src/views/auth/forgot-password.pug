extends ../layout

block content
  .row.justify-content-center
    .col-md-6
      .card.border-primary.shadow
        .card-header.bg-primary.text-white
          h4.mb-0 Redefinir Senha
        .card-body
          form(action='/password/forgot', method='POST')
            .mb-3
              label.form-label(for='email') E-mail
              input#email.form-control(type='email', name='email', value=email || '', required, autofocus)

            .d-grid.gap-2
              button.btn.btn-primary(type='submit') Enviar Link

          hr

          .text-center
            a.btn.btn-outline-secondary(href='/login') Voltar para Login
