extends ../layout

block content
  .row.justify-content-center
    .col-md-6
      .card.border-primary.shadow
        .card-header.bg-primary.text-white
          h4.mb-0 Nova Senha
        .card-body
          form(action='/password/reset', method='POST')
            input(type='hidden', name='token', value=token || '')

            .mb-3
              label.form-label(for='password') Nova Senha
              input#password.form-control(type='password', name='password', required, autofocus)

            .mb-3
              label.form-label(for='confirmPassword') Confirmar Nova Senha
              input#confirmPassword.form-control(type='password', name='confirmPassword', required)

            .d-grid.gap-2
              button.btn.btn-primary(type='submit') Redefinir Senha

          hr

          .text-center
            a.btn.btn-outline-secondary(href='/login') Voltar para Login
