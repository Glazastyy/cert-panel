doctype html
html(lang='pt-BR', data-bs-theme='light')
  head
    meta(charset='utf-8')
    meta(name='viewport', content='width=device-width, initial-scale=1')
    title= title || 'ZeroCert - Simulador ICP-Brasil'
    script.
      (function() {
        try {
          var storedTheme = localStorage.getItem('zerocert-theme');
          var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = storedTheme || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-bs-theme', theme === 'dark' ? 'dark' : 'light');
        } catch (error) {
          document.documentElement.setAttribute('data-bs-theme', 'light');
        }
      })();
    link(rel='stylesheet', href='/css/bootstrap.min.css')
    link(rel='stylesheet', href='/css/bootstrap-icons.min.css')
    link(rel='stylesheet', href='/css/custom.css')
    block styles
  body.app-body
    nav.navbar.navbar-expand-lg.navbar-dark.bg-primary.mb-4
      .container
        a.navbar-brand(href='/')
          img.me-2(src='/img/logo.svg', alt='ZeroCert Logo', height='30')
          | ZeroCert ICP-Brasil
        button.navbar-toggler(type='button', data-bs-toggle='collapse', data-bs-target='#navbarNav')
          span.navbar-toggler-icon
        #navbarNav.collapse.navbar-collapse
          ul.navbar-nav.me-auto
            if user
              li.nav-item
                a.nav-link(href='/dashboard') Dashboard
              if user.role === 'admin' || user.role === 'operator'
                li.nav-item.dropdown
                  a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown') Certificados
                  ul.dropdown-menu
                    li
                      a.dropdown-item(href='/dashboard/certificates') Listar Certificados
                    li
                      a.dropdown-item(href='/certificates/issue/ecpf') Emitir e-CPF
                    li
                      a.dropdown-item(href='/certificates/issue/ecnpj') Emitir e-CNPJ
                    li
                      a.dropdown-item(href='/certificates/validate') Validar Certificado
              else
                li.nav-item.dropdown
                  a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown') Certificados
                  ul.dropdown-menu
                    li
                      a.dropdown-item(href='/certificates/request/ecpf') Solicitar e-CPF
                    li
                      a.dropdown-item(href='/certificates/request/ecnpj') Solicitar e-CNPJ
                    li
                      a.dropdown-item(href='/certificates/validate') Validar Certificado
              if user.role === 'admin'
                li.nav-item
                  a.nav-link(href='/dashboard/certificate-requests') Solicitações
                li.nav-item
                  a.nav-link(href='/dashboard/emails') E-mails
                li.nav-item
                  a.nav-link(href='/dashboard/users') Usuários
          ul.navbar-nav
            li.nav-item.d-flex.align-items-center.me-2
              button#themeToggle.btn.btn-outline-light.btn-sm(type='button', aria-label='Alternar modo noturno', title='Alternar modo noturno')
                i.bi.bi-moon-stars
            if user
              li.nav-item.dropdown
                a.nav-link.dropdown-toggle(href='#', role='button', data-bs-toggle='dropdown')
                  | #{user.fullName}
                ul.dropdown-menu.dropdown-menu-end
                  li
                    a.dropdown-item(href='/dashboard/profile') Meu Perfil
                  li
                    hr.dropdown-divider
                  li
                    a.dropdown-item(href='/logout') Sair
            else
              li.nav-item
                a.nav-link(href='/login') Login
              li.nav-item
                a.nav-link(href='/register') Registro
    
    main.app-main.container.mb-5
      if error
        .alert.alert-danger.alert-dismissible.fade.show
          button.btn-close(type='button', data-bs-dismiss='alert')
          strong Erro: 
          | #{error}
      
      if success
        .alert.alert-success.alert-dismissible.fade.show
          button.btn-close(type='button', data-bs-dismiss='alert')
          strong Sucesso: 
          | #{success}
      
      block content

    if requireNameCorrection
      #nameCorrectionModal.modal.fade(tabindex='-1', data-bs-backdrop='static', data-bs-keyboard='false')
        .modal-dialog.modal-dialog-centered
          .modal-content
            .modal-header.bg-warning
              h5.modal-title Corrija seu nome completo
            .modal-body
              p.mb-0 Seu cadastro precisa ter nome e sobrenome, em letras maiúsculas e sem caracteres especiais. Atualize seu perfil para continuar com os dados corretos.
            .modal-footer
              a.btn.btn-primary(href='/dashboard/profile') Corrigir Agora
    
    footer.footer.mt-auto.py-3.bg-light
      .container.text-center
        p.text-muted.mb-0 ZeroCert - Simulador ICP-Brasil para Ambiente de Teste
        p.text-muted.small.mb-0 Este sistema é apenas para fins de teste e não emite certificados oficiais da ICP-Brasil.
    
    script(src='/js/bootstrap.bundle.min.js')
    script(src='/js/custom.js')
    if requireNameCorrection
      script.
        document.addEventListener('DOMContentLoaded', function() {
          var modalElement = document.getElementById('nameCorrectionModal');
          if (modalElement && window.bootstrap) {
            new window.bootstrap.Modal(modalElement).show();
          }
        });
    block scripts
