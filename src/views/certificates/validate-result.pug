extends ../layout

block content
  .row.justify-content-center
    .col-md-8
      .card.border-primary
        .card-header.bg-primary.text-white
          h4.mb-0 Resultado da Validação
        
        .card-body
          .mb-4
            h5.border-bottom.pb-2 Status do Certificado
            
            .d-flex.align-items-center.mb-3
              strong.me-2 Status: 
              if status === 'valid'
                span.badge.bg-success.fs-6 Válido
              else
                span.badge.bg-danger.fs-6 Inválido
            
            .alert(class=status === 'valid' ? 'alert-success' : 'alert-danger')
              i(class=`bi ${status === 'valid' ? 'bi-check-circle-fill' : 'bi-x-circle-fill'} me-2`)
              | #{message}
          
          .row
            .col-md-12
              .d-flex.justify-content-between
                a.btn.btn-secondary(href='/certificates/validate')
                  i.bi.bi-arrow-left.me-2
                  | Voltar para Validação

