extends ../layout

block content
  .row.justify-content-center
    .col-md-10
      .card.border-primary
        .card-header.bg-primary.text-white
          h4.mb-0 Solicitar Certificado e-CPF
        .card-body
          form.certificate-request-form(action='/certificates/request/ecpf', method='POST', novalidate)
            h5.mb-3 Dados Pessoais
            .row.mb-3
              .col-md-6
                label.form-label(for='name') Nome Completo
                input#name.form-control(type='text', name='name', value=formData ? formData.name : user.fullName, required)
              .col-md-6
                label.form-label(for='cpf') CPF
                input#cpf.form-control.cpf-mask.validate-cpf(type='text', name='cpf', value=formData ? formData.cpf : '', placeholder='000.000.000-00', inputmode='numeric', autocomplete='off', required)
            .row.mb-3
              .col-md-4
                label.form-label(for='birthDate') Data de Nascimento
                input#birthDate.form-control.birth-date-validation(type='date', name='birthDate', value=formData ? formData.birthDate : '', required)
              .col-md-4
                label.form-label(for='socialSecurity') PIS/PASEP/NIS (opcional)
                input#socialSecurity.form-control.pis-mask.validate-pis(type='text', name='socialSecurity', value=formData ? formData.socialSecurity : '', placeholder='000.00000.00-0', inputmode='numeric', autocomplete='off')
              .col-md-4
                label.form-label(for='email') E-mail
                input#email.form-control(type='email', name='email', value=formData ? formData.email : user.email, required)
            h5.mt-4.mb-3 Endereço
            .row.mb-3
              .col-md-6
                label.form-label(for='state') Estado
                select#state.form-select(name='state', required)
                  option(value='', disabled, selected=!formData) Selecione um estado
                  each uf in ['AC','AL','AP','AM','BA','CE','DF','ES','GO','MA','MT','MS','MG','PA','PB','PR','PE','PI','RJ','RN','RS','RO','RR','SC','SP','SE','TO']
                    option(value=uf, selected=formData && formData.state === uf)= uf
              .col-md-6
                label.form-label(for='city') Cidade
                input#city.form-control(type='text', name='city', value=formData ? formData.city : '', required)
            .d-flex.justify-content-between.mt-4
              a.btn.btn-secondary(href='/dashboard')
                i.bi.bi-arrow-left.me-2
                | Voltar
              button.btn.btn-primary(type='submit')
                i.bi.bi-send.me-2
                | Enviar Solicitação

block scripts
  script(src='/js/certificate-request.js')
